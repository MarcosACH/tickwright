# Config for compose.example.yaml: a paper replay with a mounted user strategy.
# .env.example lists every variable and what it does.
TICKWRIGHT_REPLAY__PATH=/replay/ticks.jsonl
TICKWRIGHT_PAPER__GENESIS_COLLATERAL=100000
TICKWRIGHT_PAPER__INSTRUMENT_SPECS={"BTC": {"symbol": "BTC", "sz_decimals": 3, "max_decimals": 6, "max_sig_figs": 5, "min_notional": "10"}}
TICKWRIGHT_STRATEGIES=[{"strategy": "buy_once:BuyOnce", "strategy_id": "example", "symbols": ["BTC"], "settings": {"quantity": "0.5"}}]

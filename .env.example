# Tickwright CLI configuration (`tickwright` / `python -m tickwright.app`).
# Copy to `.env` and adjust. Every variable maps onto `AppConfig`
# (src/tickwright/app/config.py): nesting uses `__`, complex values are JSON.

# --- Seam discriminants (ADR-0032) — which impl serves each Protocol seam.
# Shown here at their defaults; today's shipped impls are exactly these
# (plus bus=kafka, store=postgres, feed=hyperliquid, exchange=hyperliquid,
# and guard=noop). An unknown value fails validation with a readable error.
#TICKWRIGHT_BUS=in_memory
#TICKWRIGHT_STORE=sqlite
#TICKWRIGHT_EXCHANGE=paper
#TICKWRIGHT_FEED=replay
#TICKWRIGHT_GUARD=real

# --- Per-adapter configs (each defined in its adapter's package).
# The JSONL tick file the deterministic replay drives from (ADR-0027).
# Required when feed=replay (the default); ignored otherwise.
TICKWRIGHT_REPLAY__PATH=ticks.jsonl
# The live Hyperliquid feed (ADR-0021/0027), read only when
# TICKWRIGHT_FEED=hyperliquid — which also puts the engine on the wall clock
# (LiveClock) instead of replay-driven virtual time. No API key: the trades
# WS channel is unauthenticated. SYMBOLS (JSON, at least one) are the venue
# coins to subscribe; TESTNET picks the testnet endpoint. Reconnects double
# from the initial backoff up to the max (ADR-0023 ingress conflation is
# always on for this feed).
#TICKWRIGHT_HYPERLIQUID__SYMBOLS=["BTC"]
#TICKWRIGHT_HYPERLIQUID__TESTNET=false
#TICKWRIGHT_HYPERLIQUID__RECONNECT_INITIAL_BACKOFF_SECONDS=1
#TICKWRIGHT_HYPERLIQUID__RECONNECT_MAX_BACKOFF_SECONDS=60
# The live Hyperliquid exchange write path (ADR-0021/0030), read only when
# TICKWRIGHT_EXCHANGE=hyperliquid. SIGNING_KEY is required then — env-only,
# never persisted, redacted from logs (the paper default needs no key).
# ACCOUNT_ADDRESS is only for an API/agent wallet acting for a master account
# (defaults to the key's own address). SLIPPAGE_BOUND caps the MARKET →
# aggressive-IOC translation price at latest × (1 ± bound).
#TICKWRIGHT_HYPERLIQUID__SIGNING_KEY=
#TICKWRIGHT_HYPERLIQUID__ACCOUNT_ADDRESS=
#TICKWRIGHT_HYPERLIQUID__SLIPPAGE_BOUND=0.05
# Where the durable saga checkpoints live, when store=sqlite (ADR-0019).
# Relative to the CWD.
TICKWRIGHT_SQLITE__PATH=tickwright.db
# The production-parity store (ADR-0019), read only when TICKWRIGHT_STORE=postgres.
# Defaults to the local `docker compose up postgres` service; point it at your
# managed Postgres in production. Per-process — never share one DSN between engines.
#TICKWRIGHT_POSTGRES__DSN=postgresql://tickwright:tickwright@localhost:5432/tickwright
# The paper venue's per-symbol InstrumentSpecs (ADR-0031) — JSON. The
# composition root also wires these into the pre-trade guard.
TICKWRIGHT_PAPER__INSTRUMENT_SPECS={"BTC": {"symbol": "BTC", "sz_decimals": 3, "max_decimals": 6, "max_sig_figs": 5, "min_notional": "10"}}
# The paper fill model (ADR-0012). Default `immediate` is deterministic,
# optimistic, zero-slippage, full-fill and needs none of the fields below.
# `stochastic` is seeded — same seed + tick stream ⇒ byte-identical fills — and
# reads the `seed` (to build the RNG) plus the StochasticParams bundle nested
# under `STOCHASTIC` (slippage / queue-position / partial / latency knobs); their
# defaults are inert, so an unseeded stochastic model still behaves optimistically.
#TICKWRIGHT_PAPER__FILL_MODEL=stochastic
#TICKWRIGHT_PAPER__SEED=0
#TICKWRIGHT_PAPER__STOCHASTIC__PROB_SLIPPAGE=0.0
#TICKWRIGHT_PAPER__STOCHASTIC__MAX_SLIPPAGE=0
#TICKWRIGHT_PAPER__STOCHASTIC__PROB_FILL_ON_LIMIT=1.0
#TICKWRIGHT_PAPER__STOCHASTIC__PARTIAL_FILL_FRACTION=1
#TICKWRIGHT_PAPER__STOCHASTIC__LATENCY_SECONDS=0.0

# The Kafka bus backend (ADR-0028), read only when TICKWRIGHT_BUS=kafka: one
# keyed topic, one consumer group. The topic, group id, and store path are
# per-process — two engine processes must never share any of them (instance
# isolation; unqualified symbols like BTC would collide on a shared topic).
#TICKWRIGHT_KAFKA__BOOTSTRAP_SERVERS=localhost:9092
#TICKWRIGHT_KAFKA__EVENTS_TOPIC=tickwright.events
#TICKWRIGHT_KAFKA__GROUP_ID=tickwright

# --- Hosted strategies — JSON list; `price` is required for single_shot_limit.
TICKWRIGHT_STRATEGIES=[{"kind": "single_shot_market", "strategy_id": "demo", "symbol": "BTC", "side": "buy", "quantity": "0.5"}]

# --- Engine lifecycle knobs (ADR-0024 defaults).
#TICKWRIGHT_ENGINE__STARTUP_RECONCILIATION_TIMEOUT_SECONDS=60
#TICKWRIGHT_ENGINE__SHUTDOWN_TIMEOUT_SECONDS=10

#!/usr/bin/env bash
# Pre-push: type-check before a push leaves the machine, to catch the most common
# CI red (type errors) that the pre-commit hook can't. Convenience only — CI is
# the authoritative gate and re-runs everything; `git push --no-verify` skips
# this. Enabled via core.hooksPath (see pre-commit).
#
# mypy runs only if Python changed across the commits being pushed. Uncommitted
# work is stashed first so the check sees the committed state being pushed.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

zero="0000000000000000000000000000000000000000"

# git feeds one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>
run_mypy=0
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # branch deletion — nothing to check
  if [ "$remote_sha" != "$zero" ]; then
    range="$remote_sha..$local_sha"                 # existing branch: only the new commits
  else
    base="$(git merge-base origin/main "$local_sha" 2>/dev/null || true)"
    if [ -n "$base" ]; then
      range="$base..$local_sha"                     # new branch: diff vs main
    else
      run_mypy=1; continue                          # no base to compare — check everything
    fi
  fi
  git diff --name-only "$range" | grep -qE '\.py$' && run_mypy=1
done

[ "$run_mypy" = 0 ] && exit 0

# Autostash: type-check the committed state being pushed, not whatever happens to
# be dirty in the working tree. Tracked changes only; the restore lands on a then-
# clean tree so it never conflicts. Restore the real exit code so a type error blocks
# push.
#
# Deliberately off the shared refs/stash stack (see CONTRIBUTING.md "Per-worktree vs
# shared git state"): an unqualified `git stash pop` (== stash@{0}) could restore an
# entry another worktree pushed while mypy ran, silently swapping uncommitted work.
# Instead `git stash create` snapshots the dirty tree into a commit without touching
# any stack; we park that commit under refs/worktree/ — git's per-worktree ref
# namespace — so concurrent pre-push runs never collide and a crash leaves the work
# recoverable by name. Restore exactly that commit: never another worktree's work, and
# nothing of anyone else's to drop.
autostash_ref="refs/worktree/pre-push-autostash"
stashed=0
cleanup() {
  local rc=$?
  if [ "$stashed" = 1 ]; then
    if git stash apply --quiet "$autostash_ref"; then
      git update-ref -d "$autostash_ref"
    else
      echo "pre-push: could not restore your autostash — your uncommitted work is safe" >&2
      echo "pre-push: at $autostash_ref; recover it with 'git stash apply $autostash_ref'" >&2
    fi
  fi
  exit "$rc"
}
trap cleanup EXIT
if ! git diff --quiet || ! git diff --cached --quiet; then
  git update-ref "$autostash_ref" "$(git stash create "pre-push autostash")"
  git reset --hard --quiet
  stashed=1
fi

echo "pre-push: mypy"
uv run mypy .

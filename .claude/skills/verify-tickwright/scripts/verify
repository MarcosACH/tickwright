#!/bin/sh
# Runs verify.py on the project venv's own interpreter, from any cwd.
# The venv binary, not `uv run`: it skips the re-sync and the children it
# spawns inherit the same interpreter.
set -e
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../../../.." && pwd)
python="$root/.venv/bin/python"
if [ ! -x "$python" ]; then
  echo "no venv at $root/.venv: run 'uv venv && uv sync' first" >&2
  exit 1
fi
exec "$python" "$here/verify.py" "$@"

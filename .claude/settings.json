{
  "permissions": {
    "deny": [
      "Read(./.venv/**)",
      "Read(./**/.venv/**)",
      "Read(./**/__pycache__/**)",
      "Read(./.mypy_cache/**)",
      "Read(./.pytest_cache/**)",
      "Read(./.ruff_cache/**)",
      "Read(./.import_linter_cache/**)",
      "Read(./**/*.pyc)",
      "Read(./**/*.egg-info/**)",
      "Read(./logs/**)",
      "Read(./**/*.log)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/no-tracked-writes.py",
            "statusMessage": "Checking the write target..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/no-excluded-reads.py",
            "statusMessage": "Checking the read target..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/no-global-installs.py",
            "statusMessage": "Checking the install target..."
          }
        ]
      }
    ]
  }
}
